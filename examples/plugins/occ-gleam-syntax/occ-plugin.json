{
  "$schema": "https://raw.githubusercontent.com/stablyai/occ/main/docs/schemas/plugins/occ-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "data",
  "id": "occ-gleam-syntax",
  "publisher": "stablyai",
  "name": "Gleam",
  "version": "1.0.0",
  "description": "Syntax highlighting for Gleam files.",
  "engines": { "occ": ">=1.4.245" },
  "contributes": {
    "syntaxes": [
      {
        "id": "gleam",
        "title": "Gleam",
        "scopeName": "source.gleam",
        "path": "syntaxes/gleam.tmLanguage.json",
        "configuration": "syntaxes/language-configuration.json",
        "extensions": [".gleam"]
      }
    ]
  }
}
